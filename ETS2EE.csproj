<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>app_icon.ico</ApplicationIcon>

    <!-- Ausgabename der EXE-Datei & RootNamespace für EmbeddedResources -->
    <AssemblyName>ETS2EE</AssemblyName>
    <RootNamespace>ETS2_ModTool</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>ETS2 Economy Equalizer</Product>
    <Company>refskegg</Company>
    <Authors>refskegg</Authors>

    <!-- Single-File & Standalone Konfiguration -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- Erzwingt das Einbetten aller DLLs und nativer Bibliotheken -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>

    <!-- Verhindert separate Sprachordner (de, fr, it...) im Publish-Ordner -->
    <SatelliteResourceLanguages>en-US</SatelliteResourceLanguages>

    <!-- Keine externen .pdb-Symboldateien erzeugen -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!-- Templates und Presets als EmbeddedResource einbinden -->
  <ItemGroup>
    <EmbeddedResource Include="Templates\**\*" />
    <EmbeddedResource Include="Presets\**\*" />
  </ItemGroup>

</Project>