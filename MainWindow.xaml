<Window x:Class="ETS2_ModTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ETS2 Economy Equalizer v1.0-legacy"
        Width="1180" Height="780"
        MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgPrimaryBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Main Workspace (Sidebar + Content) -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar Navigation -->
            <Border Grid.Column="0" Background="{StaticResource BgSecondaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- App Brand Header + Language Switcher -->
                    <Border Grid.Row="0" Padding="18,18,14,15" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{StaticResource AccentBrush}" CornerRadius="6" Width="28" Height="28" Margin="0,0,10,0">
                                    <TextBlock Text="🚚" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="ETS2 ECONOMY" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                        <TextBlock Text="EQUALIZER" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                        <Border Background="#2A303C" BorderBrush="#374151" BorderThickness="1" CornerRadius="3" Padding="4,0.5" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="v1.0-legacy" FontSize="9" FontWeight="Bold" Foreground="#D1D5DB"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <!-- Language Switcher Button -->
                            <Button x:Name="btnLanguage" Grid.Column="1" Content="🇩🇪 DE"
                                    Style="{StaticResource ModernButtonStyle}" Padding="8,4" FontSize="11.5"
                                    VerticalAlignment="Center" Click="btnLanguage_Click"
                                    ToolTip="Sprache wechseln / Switch language (Deutsch / English)"/>
                        </Grid>
                    </Border>

                    <!-- Quick Preset Selector in Sidebar -->
                    <StackPanel Grid.Row="1" Margin="14,14,14,8">
                        <Grid Margin="4,0,0,6">
                            <TextBlock x:Name="lblQuickPreset" Text="SCHNELL-PRESET" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                            <Button x:Name="btnResetDefault" Content="↺ Standard" HorizontalAlignment="Right" Padding="6,2" FontSize="11"
                                    Style="{StaticResource ModernButtonStyle}" Click="btnResetDefault_Click"
                                    ToolTip="Alle Werte sofort auf Standard (Vanilla) zurücksetzen"/>
                        </Grid>
                        <ComboBox x:Name="cmbPresets" SelectedIndex="0" SelectionChanged="cmbPresets_SelectionChanged"
                                  Height="34" Padding="8,4" FontSize="12.5">
                            <ComboBoxItem x:Name="cbiPresetVanilla" Content="⚙️ Standard (Vanilla)"/>
                            <ComboBoxItem x:Name="cbiPresetBalanced" Content="⚖️ Realismus Light (Ausgewogen)"/>
                            <ComboBoxItem x:Name="cbiPresetHardcore" Content="💀 Hardcore Real Economy"/>
                            <ComboBoxItem x:Name="cbiPresetUsedCareer" Content="🚛 Gebrauchtwagen-Karriere"/>
                            <ComboBoxItem x:Name="cbiPresetRelaxed" Content="🛡️ Entspannt (Kein Schaden/Polizei)"/>
                            <ComboBoxItem x:Name="cbiPresetArcade" Content="⚡ Schnelles Geld &amp; XP (Arcade)"/>
                        </ComboBox>
                        <TextBlock x:Name="txtPresetDescription"
                                   Text="Unveränderte Originalwerte von SCS Software (15 €/km Basis, 1,0 XP/km)."
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" LineHeight="15" Margin="4,6,4,2"/>
                    </StackPanel>

                    <!-- Category Navigation List -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,6,0,10">
                        <StackPanel x:Name="navStackPanel">
                            <TextBlock x:Name="lblCategoriesHeader" Text="KATEGORIEN" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="18,6,0,6"/>
                            <RadioButton x:Name="navAll" Content="🌐  Alle Kategorien" Tag="ALL" Style="{StaticResource NavButtonStyle}" IsChecked="True" Checked="NavButton_Checked"/>
                            <RadioButton x:Name="navBank" Content="🏦  1. Bank &amp; Kredite" Tag="Bank" Style="{StaticResource NavButtonStyle}" Checked="NavButton_Checked"/>
                            <RadioButton x:Name="navDamage" Content="💥  2. Schaden &amp; Verschleiß" Tag="Damage" Style="{StaticResource NavButtonStyle}" Checked="NavButton_Checked"/>
                            <RadioButton x:Name="navEconomy" Content="📈  3. Wirtschaft &amp; Fracht" Tag="Economy" Style="{StaticResource NavButtonStyle}" Checked="NavButton_Checked"/>
                            <RadioButton x:Name="navPolice" Content="🚓  4. Polizei &amp; Bußgelder" Tag="Police" Style="{StaticResource NavButtonStyle}" Checked="NavButton_Checked"/>
                            <RadioButton x:Name="navService" Content="🔧  5. Werkstatt &amp; Service" Tag="Service" Style="{StaticResource NavButtonStyle}" Checked="NavButton_Checked"/>
                            <RadioButton x:Name="navSkills" Content="⭐  6. Fähigkeiten (Skills)" Tag="Skills" Style="{StaticResource NavButtonStyle}" Checked="NavButton_Checked"/>
                            <RadioButton x:Name="navEvents" Content="🔓  7. Events &amp; Freischaltung" Tag="SpecialEvents" Style="{StaticResource NavButtonStyle}" Checked="NavButton_Checked"/>
                            <RadioButton x:Name="navUsed" Content="🚛  8. Gebrauchtfahrzeuge" Tag="UsedVehicles" Style="{StaticResource NavButtonStyle}" Checked="NavButton_Checked"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Sidebar Version & Author Footer -->
                    <Border Grid.Row="3" Padding="18,10" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
                        <Grid>
                            <TextBlock Text="Version 1.0.0-legacy" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="by refskegg" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Right Content Area -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top Header Bar with Title & Live Search -->
                <Border Grid.Row="0" Background="{StaticResource BgSecondaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="24,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="320"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="txtCategoryTitle" Text="Alle Kategorien" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="txtCategorySubtitle" Text="Durchsuche und bearbeite sämtliche Parameter deiner ETS2 Wirtschaft." FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Toggle All Info Boxes Button -->
                        <Button x:Name="btnToggleAllInfos" Grid.Column="1" Content="ⓘ Alle Infos ausklappen"
                                Style="{StaticResource ModernButtonStyle}" Padding="10,6" FontSize="12" Margin="12,0,12,0"
                                VerticalAlignment="Center" Click="btnToggleAllInfos_Click"
                                ToolTip="Blendet alle detaillierten Parameter-Erklärungen gleichzeitig ein oder aus"/>

                        <!-- Search Box -->
                        <Grid Grid.Column="2" VerticalAlignment="Center">
                            <TextBox x:Name="txtSearch" Style="{StaticResource ModernTextBoxStyle}" Height="36" Padding="32,0,28,0"
                                     TextChanged="txtSearch_TextChanged" ToolTip="Tippe zum Filtern nach Namen oder Beschreibung..."/>
                            <TextBlock Text="🔍" FontSize="13" Foreground="{StaticResource TextMutedBrush}" IsHitTestVisible="False"
                                       VerticalAlignment="Center" HorizontalAlignment="Left" Margin="11,0,0,0"/>
                            <TextBlock x:Name="txtSearchPlaceholder" Text="Parameter suchen (z. B. Kredit, Blitzer, XP)..."
                                       FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" IsHitTestVisible="False"
                                       VerticalAlignment="Center" HorizontalAlignment="Left" Margin="34,0,0,0"/>
                            <Button x:Name="btnClearSearch" Content="✕" Visibility="Collapsed" Click="btnClearSearch_Click"
                                    Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondaryBrush}"
                                    Cursor="Hand" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Padding="4"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Dynamic Settings Cards Container -->
                <ScrollViewer x:Name="settingsScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,18,24,24">
                    <StackPanel x:Name="cardsContainer"/>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Bottom Action Bar (Mod Metadata & Export/Import) -->
        <Border Grid.Row="1" Background="{StaticResource BgSecondaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Mod Name Input -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock x:Name="lblModName" Text="Mod-Name:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13" FontWeight="Medium"/>
                    <TextBox x:Name="txtModName" Text="Mein Custom Mod" Style="{StaticResource ModernTextBoxStyle}" Width="190" Height="34"/>
                </StackPanel>

                <!-- Author Input -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="lblAuthor" Text="Autor:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13" FontWeight="Medium"/>
                    <TextBox x:Name="txtAuthor" Text="Modder" Style="{StaticResource ModernTextBoxStyle}" Width="150" Height="34"/>
                </StackPanel>

                <!-- Status Message -->
                <TextBlock x:Name="txtStatus" Grid.Column="2" Text="Bereit." Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="20,0" FontSize="12.5" TextTrimming="CharacterEllipsis"/>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnImport" Content="📥 .scs / .zip importieren" Style="{StaticResource ModernButtonStyle}" Margin="0,0,10,0" Click="btnImport_Click" ToolTip="Bestehende Mod-Datei (.scs oder .zip) einlesen"/>
                    <Button x:Name="btnExportToModFolder" Content="📁 Direkt in ETS2 Mod-Ordner" Style="{StaticResource ModernButtonStyle}" Margin="0,0,10,0" Click="btnExportToModFolder_Click" ToolTip="Erstellt die .scs Datei direkt unter Dokumente\Euro Truck Simulator 2\mod"/>
                    <Button x:Name="btnExport" Content="🚀 Mod (.scs) exportieren" Style="{StaticResource AccentButtonStyle}" Click="btnExport_Click" ToolTip="Mod-Paket an einem beliebigen Ort speichern"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
